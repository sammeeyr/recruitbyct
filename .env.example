# ====================================================================
# Cube Tech Consults — Production Environment Variables (.env.example)
# ====================================================================

# 1. AI OCR & Resume Parsing (Google Gemini / Anthropic)
GEMINI_API_KEY=your_gemini_api_key_here
ANTHROPIC_API_KEY=your_claude_api_key_here

# 2. Nigerian SMS & WhatsApp Gateway (Termii)
# https://termii.com
TERMII_API_KEY=your_termii_api_key_here
TERMII_SENDER_ID=CubeTech

# 3. Nigerian Payment Gateway & Invoicing (Paystack)
# https://paystack.com
PAYSTACK_SECRET_KEY=sk_live_your_paystack_secret_key
PAYSTACK_PUBLIC_KEY=pk_live_your_paystack_public_key

# 4. Google Workspace Service Account (Drive & Sheets)
# Base64-encoded or path to Service Account JSON key
GOOGLE_SERVICE_ACCOUNT_KEY=your_service_account_json_base64
GOOGLE_RECRUITMENT_DRIVE_FOLDER_ID=1AbCdEfGhIjKlMnOpQrStUvWxYz
GOOGLE_APPLICATIONS_SHEET_ID=1XyZaBcDeFgHiJkLmNoPqRsTuVw

# 5. Cloudflare R2 / AWS S3 Object Storage for Resumes
CLOUDFLARE_R2_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_R2_ACCESS_KEY_ID=your_r2_access_key
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your_r2_secret_key
CLOUDFLARE_R2_BUCKET_NAME=cubetech-resumes-prod
CLOUDFLARE_R2_PUBLIC_URL=https://resumes.cubetechconsults.com

# 6. Database Connection (PostgreSQL / Supabase / Neon)
DATABASE_URL=postgresql://postgres:password@db.supabase.co:5432/postgres
DIRECT_URL=postgresql://postgres:password@db.supabase.co:5432/postgres

# 7. JWT Authentication & Session Secrets
JWT_SECRET=super_secret_jwt_key_cubetech_production_2026
NEXT_PUBLIC_APP_URL=https://cubetechconsults.com
